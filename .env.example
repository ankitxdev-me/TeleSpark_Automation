# =================================================================
# TeleSpark Automation API Configuration
# =================================================================

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Authentication
MASTER_API_KEY=master-secret-key-change-in-production

# PostgreSQL
DATABASE_URL="postgresql://telespark:telespark_secure_pass@localhost:5432/telespark_db?schema=public"
POSTGRES_USER=telespark
POSTGRES_PASSWORD=telespark_secure_pass
POSTGRES_DB=telespark_db
POSTGRES_PORT=5432

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Task Execution & Scheduling Policies
MAX_TASK_ATTEMPTS=5
DEFAULT_RETRY_BASE_DELAY_MS=2000
MAX_RETRY_DELAY_MS=60000
RETRY_JITTER_MS=1000

# Leasing Policies
DEFAULT_LEASE_DURATION_SECONDS=30
LEASE_RENEW_INTERVAL_SECONDS=10
LEASE_EXPIRATION_CHECK_INTERVAL_MS=5000

# Account Policies
ACCOUNT_DEFAULT_MAX_CONCURRENCY=1
DEFAULT_COOLDOWN_DURATION_SECONDS=300
MAX_CONSECUTIVE_FAILURES_BEFORE_RESTRICTED=5

# Worker Concurrency
WORKER_CONCURRENCY=5

# Python Telegram Executor
PYTHON_EXECUTOR_PATH=python
TELEGRAM_EXECUTOR_SCRIPT=python/telegram_executor.py
TELEGRAM_SESSION_STORAGE_DIR=sessions
TELEGRAM_SIMULATION_MODE=true # Set to false to run live MTProto sessions via Telethon
