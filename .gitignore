# =================================================================
# TeleSpark Automation API - Git Ignore Rules
# =================================================================

# 1. Environment & Secrets (NEVER COMMIT TO GITHUB)
.env
.env.local
.env.*.local
*.env
!.env.example

# 2. Database Dumps, SQL Backups & Data Files
*.sql
*.dump
*.db
*.sqlite
*.sqlite3
telespark_backup.sql
*.bak

# 3. Telegram Session Strings & Credentials
*.session
*.session-journal
/sessions
sessions/
*.session-spec

# 4. Compiled Code & Dependencies
/dist
/node_modules
/build

# 5. Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
venv/
.venv/
env/
.pytest_cache/

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. IDE & Operating System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 8. Temporary & Test Artifacts
coverage/
.nyc_output/
.tempmediaStorage/
scratch/
